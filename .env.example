# Copy to .env and adjust. All values below are synthetic demo values.

# ---- services/api ----
PORT=8080   # 컨테이너 내부 포트. 호스트 공개 포트는 docker-compose.yml에서 8123
NODE_ENV=development
JWT_SECRET=demo-only-change-me-1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Path INSIDE the api container/host where the (git-ignored) shadow route
# definitions live. Leave unset / point at a nonexistent file to boot the API
# with Common + Code-only routes only.
RUNTIME_ROUTES_FILE=/runtime/shadow-routes.json
# Feature flag for POST /api/v1/loans/apply (kept off for the demo; route is
# still registered so the code scanner finds it).
FEATURE_LOANS_ENABLED=false

# Demo account passwords (synthetic; shared by the API's seed data and by the
# traffic-generator, which logs in as these users).
DEMO_ALICE_PASSWORD=Demo!Passw0rd-Alice1
DEMO_BOB_PASSWORD=Demo!Passw0rd-Bob2
DEMO_CAROL_PASSWORD=Demo!Passw0rd-Carol3

# ---- services/traffic-generator ----
# Point this at the F5 XC HTTP Load Balancer FQDN, NEVER at the origin VM
# directly -- traffic must pass through XC for API Discovery to see it.
TARGET_BASE_URL=https://your-xc-lb-fqdn.example.com
REQUESTS_PER_MINUTE=6
DURATION_HOURS=4
# Same path pattern as RUNTIME_ROUTES_FILE above; when the traffic-generator
# container also mounts deploy/runtime read-only, set this to the same file so
# it can occasionally call the Shadow endpoints without any shadow path string
# ever being written into git-tracked source.
SHADOW_ROUTES_FILE=/runtime/shadow-routes.json
