# 복사해서 .env로 쓴다. 전부 데모용 합성 값이다.

PORT=8080
NODE_ENV=development

JWT_SECRET=demo-only-change-me-1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Shadow 라우트 정의 파일 경로. 지정하지 않거나 파일이 없으면 서버는
# Common + Code-only만 서비스하고 Shadow 경로는 404가 된다.
RUNTIME_ROUTES_FILE=

# POST /api/v1/loans/apply 피처 플래그. 꺼두면 503을 반환하지만 라우트는
# 여전히 등록되어 코드 스캐너에 잡힌다.
FEATURE_LOANS_ENABLED=false

# 데모 계정 비밀번호. 하네스의 트래픽 생성기도 같은 값을 쓴다.
DEMO_ALICE_PASSWORD=Demo!Passw0rd-Alice1
DEMO_BOB_PASSWORD=Demo!Passw0rd-Bob2
DEMO_CAROL_PASSWORD=Demo!Passw0rd-Carol3
